# Habit Log runtime configuration
# Copy to `.env` for local development: `cp .env.example .env`

# App mode
APP_ENV=local

# Network
HABIT_LOG_HOST=0.0.0.0
HABIT_LOG_PORT=10021

# Storage
DATA_DIR=.data
HABIT_LOG_DB_PATH=.data/habit-log.db

# Auth/session
# For quick local testing, `scripts/dev` auto-generates a test hash if this is empty.
HABIT_LOG_PASSWORD_HASH=
HABIT_LOG_SECRET_KEY=dev-secret-key-change-me
HABIT_LOG_SESSION_DAYS=30
HABIT_LOG_SESSION_COOKIE_SECURE=false
